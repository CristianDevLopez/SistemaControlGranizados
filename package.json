{
  "name": "dexter-mostrador",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "tsc -b && vitest run",
    "graph": "codegraph sync .",
    "graph:status": "codegraph status .",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "superadmin": "tsx scripts/superadmin.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "build:e2e": "vite build --mode e2e --outDir .local/e2e-dist",
    "icons": "tsx scripts/create-icons.ts",
    "format": "prettier --write src tests scripts supabase/functions vite.config.ts playwright.config.ts package.json tsconfig.json vercel.json README.md docs .github .prettierrc.json",
    "format:check": "prettier --check src tests scripts supabase/functions vite.config.ts playwright.config.ts package.json tsconfig.json vercel.json README.md docs .github .prettierrc.json"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@zxing/browser": "0.2.1",
    "dexie": "4.4.7",
    "fflate": "0.8.3",
    "lucide-react": "1.61.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@electric-sql/pglite": "0.5.11",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.6",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  }
}
